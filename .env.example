# ------------------------------------------------------------------------------
# Jupiter Sonic - Environment Configuration
# ------------------------------------------------------------------------------

# General Settings
ENV=development
DEBUG=true
PROJECT_NAME="Jupiter Sonic"
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "http://127.0.0.1:5173"]

# Database Settings
# - SQLite (development): sqlite:///./jupiter_sonic.db
# - PostgreSQL (production): postgresql+psycopg2://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./jupiter_sonic.db

# Audio Processing & Media Paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MODEL_DIR=./models
OUTPUT_DIR=./static/outputs
TEMP_DIR=./temp

# Local AI Engine Module Toggles (set to false to disable resource-intensive modules)
ENABLE_ASR=true
ENABLE_DIARIZATION=true
ENABLE_CLONING=true
ENABLE_TTS=true
ENABLE_TRANSLATION=true
ENABLE_ENHANCEMENT=true
ENABLE_ALIGNMENT=true
ENABLE_DUBBING=true

# Local Model Settings
# Path configurations or HF Hub model IDs for fully local inference:
ASR_MODEL_ID=openai/whisper-base
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-3.1
TTS_MODEL_ID=coqui/XTTS-v2
TRANSLATION_MODEL_ID=facebook/nllb-200-distilled-600M
ENHANCEMENT_MODEL_ID=speechbrain/metricgan-plus-voicebank
ALIGNMENT_MODEL_ID=reach-out/wav2vec2-forced-aligner
